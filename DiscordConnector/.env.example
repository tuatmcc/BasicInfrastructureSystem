# Discord Connector Workers configuration
# Local Wrangler can load this file with: pnpm wrangler dev --env-file .env

# Required for real Discord REST mode.
DISCORD_BOT_TOKEN=your_bot_token_here
DISCORD_GUILD_ID=123456789012345678

# Optional. DB mutation logs are posted to this channel when set.
DISCORD_LOG_CHANNEL_ID=123456789012345678

# Required for Supabase Auth JWT verification.
SUPABASE_PROJECT_URL=https://your-project-ref.supabase.co

# Optional Supabase JWT settings.
SUPABASE_JWT_AUDIENCE=authenticated
SUPABASE_JWT_ALGORITHMS=RS256,ES256
DISCORD_CONNECTOR_ROLE_CLAIM=app_metadata.discord_connector_roles

# Optional. Runs with in-memory Discord/DB controllers.
MOCK_MODE=true
