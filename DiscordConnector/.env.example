# Discord Connector Configuration
# Copy this file to .env and fill in your values

# Discord Bot Token (required for real mode)
# Get this from https://discord.com/developers/applications
DISCORD_BOT_TOKEN=your_bot_token_here

# Discord Guild (Server) ID (required for real mode)
# Enable Developer Mode in Discord settings, then right-click your server and "Copy Server ID"
DISCORD_GUILD_ID=123456789012345678

# Discord log channel ID (optional)
# DB updates are posted here. If unset, startup logs a warning and Discord logging is disabled.
DISCORD_LOG_CHANNEL_ID=123456789012345678

# Supabase Auth JWT verification for PublicAPI (required)
# PublicAPI verifies Supabase access tokens with the project's JWKS endpoint.
SUPABASE_PROJECT_URL=https://your-project-ref.supabase.co

# Optional Supabase JWT settings
# SUPABASE_JWT_AUDIENCE=authenticated
# SUPABASE_JWT_ALGORITHMS=RS256,ES256
# DISCORD_CONNECTOR_ROLE_CLAIM=app_metadata.discord_connector_roles

# Mock Mode (optional)
# Set to "true" to run without real Discord credentials
# Useful for API testing and development
# MOCK_MODE=true

# Usage:
#   Real mode: uv run uvicorn main:app --reload
#   Mock mode: MOCK_MODE=true uv run uvicorn main:app --reload
